# Manhwa Studio — environment variable NAMES only. Never commit real values.
#
# Phase A needs none of these: sign-in uses public OIDC configuration, and no
# AI provider is connected yet. They are declared now so Phase B/C/D adapters
# have fixed names, and so /api/integrations can report what is missing.

# --- Sign in with Freebuff (public, injected by the deployment) ---
FREEBUFF_CLIENT_ID=
FREEBUFF_ISSUER=https://freebuff.com/oidc
APP_ORIGIN=
APP_VERSION=0.1.0

# --- Phase B: script (LLM) provider ---
SCRIPT_PROVIDER=
SCRIPT_API_KEY=
SCRIPT_MODEL=

# --- Phase B: image generation provider ---
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=

# --- Phase B: voice / narration provider ---
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_VOICE_ID=

# --- Phase C: video rendering worker (FFmpeg) ---
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# --- Phase D: YouTube publishing (stays disabled until explicitly authorised) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
