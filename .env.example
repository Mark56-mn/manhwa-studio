# Manhwa Studio — environment variable NAMES only. Never commit real values.
#
# Phase A needs none of these: sign-in uses public OIDC configuration, and no
# AI provider is connected yet. They are declared now so Phase B/C/D adapters
# have fixed names, and so /api/integrations can report what is missing.

# --- Sign in with Freebuff (public, injected by the deployment) ---
FREEBUFF_CLIENT_ID=
FREEBUFF_ISSUER=https://freebuff.com/oidc
APP_ORIGIN=
APP_VERSION=0.1.0

# --- Phase B: script (LLM) provider ---  IMPLEMENTED
# SCRIPT_PROVIDER is one of: openai | openrouter | anthropic | google | custom
# SCRIPT_API_KEY is the provider credential. A provider-specific alias is also
# accepted: OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY (or GEMINI_API_KEY),
# OPENROUTER_API_KEY. Keys are deployment secrets — never commit a real value.
SCRIPT_PROVIDER=
SCRIPT_API_KEY=
# Optional: defaults to the selected provider's default model.
SCRIPT_MODEL=
# Only for SCRIPT_PROVIDER=custom (any OpenAI-compatible endpoint, e.g. a gateway).
SCRIPT_BASE_URL=
# Optional: upper bound on generated script length. Default 6000.
SCRIPT_MAX_OUTPUT_TOKENS=

# --- Optional provider-key aliases (any of these may hold the key instead) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Phase B: image generation provider ---  (TASK-004, no adapter yet)
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=

# --- Phase B: voice / narration provider ---  (TASK-005, no adapter yet)
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_VOICE_ID=

# --- Phase C: video rendering worker (FFmpeg) ---
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# --- Phase D: YouTube publishing (stays disabled until explicitly authorised) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
