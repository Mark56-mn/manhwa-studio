# Manhwa Studio — environment variable NAMES only. Never commit real values.
#
# All AI provider keys are deployment secrets. The studio only ever reports the
# variable NAMES it reads, never their values, and never sends them to the browser.

# --- Sign in with Freebuff (public, injected by the deployment) ---
FREEBUFF_CLIENT_ID=
FREEBUFF_ISSUER=https://freebuff.com/oidc
APP_ORIGIN=
APP_VERSION=0.1.0

# --- Unified AI provider adapter (TASK-003) ---
# Each provider reads only its own key. Configure as many as you like; the
# router treats them as interchangeable and only uses the ones that are set.
#
# OpenRouter — base URL defaults to https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA NIM API Catalog — base URL defaults to https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Google Gemini through Google AI Studio (official Generative Language API)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_BASE_URL=
# Baseten — base URL defaults to https://inference.baseten.co/v1
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Optional additional providers behind the same adapter interface
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# --- Router role defaults (optional; the Settings UI stores per-role choices) ---
# Used only when no per-role setting has been saved for Director AI / Script AI.
DIRECTOR_PROVIDER=
DIRECTOR_MODEL=
SCRIPT_PROVIDER=
SCRIPT_MODEL=
# Legacy single-provider key, honoured only for the provider selected above.
SCRIPT_API_KEY=
# 'true' allows the router to use a model that is not verified zero-cost.
# Default is free-only: a paid model is never chosen silently.
AI_ALLOW_PAID=
# Maximum provider attempts per task (default 4).
AI_MAX_ATTEMPTS=
# Per-attempt provider timeout in milliseconds (default 120000).
AI_TASK_TIMEOUT_MS=
# Upper bound on generated script length. Default 6000.
SCRIPT_MAX_OUTPUT_TOKENS=

# --- Live provider tests (local development only; never deployed) ---
# When present, `npm test` also runs the real-provider integration specs.
LIVE_OPENROUTER_API_KEY=
LIVE_NVIDIA_API_KEY=
LIVE_GEMINI_API_KEY=
LIVE_BASETEN_API_KEY=

# --- Phase B: image generation provider ---  (TASK-004, no adapter yet)
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=

# --- Phase B: voice / narration provider ---  (TASK-005, no adapter yet)
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_VOICE_ID=

# --- Phase C: video rendering worker (FFmpeg) ---
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# --- Phase D: YouTube publishing (stays disabled until explicitly authorised) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
