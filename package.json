{
  "name": "manhwa-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787 --ip 0.0.0.0",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply manhwa-studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply manhwa-studio --remote",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:deployed": "node scripts/verify-deployed.mjs"
  },
  "dependencies": {
    "@freebuff/auth": "0.1.0",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261013.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
